{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "法语语法练习",
  "version": "0.1.0",
  "identifier": "com.fge.open",
  "build": {
    "frontendDist": "../.fge-build/windows/public/web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "法语语法练习",
        "width": 1180,
        "height": 800,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost https://api.github.com/repos/dinayuil/french-grammar-app/releases/tags/client-latest; font-src 'self' data:; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
